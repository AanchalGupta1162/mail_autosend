{
  "name": "mail-autosend",
  "version": "1.0.0",
  "description": "Sends personalized recruiter emails from an Excel sheet, paced over a time window.",
  "type": "module",
  "main": "src/server/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server/server.js",
    "legacy:start": "node --env-file=.env src/index.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "seed:admin": "node --env-file=.env scripts/seedAdmin.js",
    "sample-sheet": "node scripts/createSampleSheet.js",
    "test": "node --env-file=.env --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "imapflow": "^1.0.167",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  }
}
