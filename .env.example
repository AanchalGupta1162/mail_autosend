# Gmail account to send from
GMAIL_USER=you@gmail.com
# Display name recipients see instead of your Gmail account's own profile name
FROM_NAME=Your Name
# Generate at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Path to the Excel sheet to read/write
EXCEL_PATH=./sample-recruiters.xlsx

# Spread all pending sends evenly across this many minutes
WINDOW_MINUTES=60

# true = log what would be sent without actually sending any email or checking replies
DRY_RUN=true

# File attached to every initial email (not re-attached on follow-ups). Leave blank to send no attachment.
RESUME_PATH=./attachments/resume-placeholder.txt

# HTML appended to the bottom of every email body. Leave blank for no signature.
SIGNATURE_PATH=./signature.html

# Days to wait after the last send before sending the next follow-up
FOLLOWUP_INTERVAL_DAYS=7

# Max number of follow-ups per row before giving up (Status becomes "Done")
FOLLOWUP_MAX_COUNT=3
