# Copy to .env and fill in. Secrets are deliberately blank: the app refuses to start without them.
# Never commit .env. In production use Secret Manager / your platform's secret store instead.

# --- Database (required) ---------------------------------------------------------------
# Postgres connection string (Neon etc.), e.g. postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
# Optional: run in a non-default schema (tests/e2e use throwaway schemas). Leave unset for "public".
# Use a DIRECT (non-pooler) connection string if you set this.
DB_SCHEMA=

# --- Web service -----------------------------------------------------------------------
# Session cookie secret: REQUIRED, at least 32 random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
PORT=3000
# development | production | test. production makes the session cookie `Secure` (HTTPS only).
NODE_ENV=development
# Number of reverse proxies in front of Express that append to X-Forwarded-For
# (0 or empty = none, the default). Only values 0-5 are accepted; "true" is refused.
# Needed so the per-IP login limit sees real client addresses. See README, "Behind a proxy".
TRUST_PROXY=

# --- Admin login (used only by `npm run seed:admin`) -----------------------------------
ADMIN_USERNAME=admin
# Minimum 10 characters. Change it afterwards in the UI (Settings > Change password).
ADMIN_PASSWORD=

# --- Sending ---------------------------------------------------------------------------
# true  = build real messages (and Message-IDs) but deliver nothing, no IMAP. Safe default.
# false = send through Gmail; requires GMAIL_* and SIGNATURE_PATH below, and a resume uploaded in Settings.
DRY_RUN=true
# Max real emails in any rolling 24h, and max per worker tick (dry runs are counted separately).
DAILY_SEND_CAP=100
MAX_PER_TICK=5
# Random gap between sends inside one tick (seconds).
SEND_GAP_SECONDS_MIN=15
SEND_GAP_SECONDS_MAX=45
# How often the in-process send worker looks for due messages (seconds).
POLL_INTERVAL_SECONDS=30
# Gmail account to send from, plus an app password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification; also enable IMAP in Gmail).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name recipients see.
FROM_NAME=
# HTML appended to every email. Real mode needs SIGNATURE_HTML or SIGNATURE_PATH (a file that exists).
# Keep the real file out of git (git-ignored).
SIGNATURE_PATH=./signature.html
# Optional raw signature HTML (max 64 KB, e.g. from Secret Manager). Takes precedence over SIGNATURE_PATH.
SIGNATURE_HTML=
# OPTIONAL legacy fallback: a PDF attached only to messages scheduled before the resume library existed.
# Normally leave empty: upload resumes in Settings > Resumes. With no library resume and no file here,
# a real send is held (never sent without a resume).
RESUME_PATH=

# --- Resume storage (the library behind Settings > Resumes) ------------------------------
# local = files on disk under RESUME_LOCAL_DIR (development). gcs = Google Cloud Storage.
RESUME_STORAGE=local
RESUME_LOCAL_DIR=./data/resumes
# Required when RESUME_STORAGE=gcs: bucket NAME without gs:// (real: mail-autosender-resumes-codecell,
# Mumbai asia-south1). Auth is Application Default Credentials: locally run
# `gcloud auth application-default login`; on Cloud Run grant the backend's service account
# roles/storage.objectUser on this bucket only. No key files.
RESUME_BUCKET=
# Reply detection over IMAP (real mode only). false disables it; follow-ups are held while it is stale.
REPLY_SWEEP_ENABLED=true

# --- Scale-to-zero deployment (Cloud Run + Cloud Scheduler) ------------------------------
# polling   = in-process send and sweep pollers (local dev, default).
# scheduled = no pollers; Cloud Scheduler calls POST /internal/tick and /internal/sweep with an OIDC token.
WORKER_MODE=polling
# Required when WORKER_MODE=scheduled: the OIDC audience (the backend's URL) and the only service account
# allowed to call /internal/*.
INTERNAL_AUDIENCE=
INTERNAL_INVOKER_SA=
# Longest one /internal/tick call keeps sending (seconds).
INTERNAL_TICK_DEADLINE_SECONDS=480
# true = real sends only inside the daily window (Settings > Send window, default 09:00-10:00 Asia/Kolkata).
# Leave false locally; set true in production. Dry runs are never gated.
SEND_WINDOW_ENFORCED=false
# Follow-ups wait while the last good reply sweep is older than this many minutes (5-1440).
SWEEP_MAX_AGE_MINUTES=90
# false = do not run migrations at server start (run `node src/db/migrate.js` as a separate job).
MIGRATE_ON_START=true

# --- Frontend (web/) -------------------------------------------------------------------
# These live in the environment of `next build` / `next start` (web/), not the backend's .env.
# BACKEND_URL is baked into the /api/* rewrite at BUILD time; set it for build and start.
# BACKEND_URL=http://127.0.0.1:3000
